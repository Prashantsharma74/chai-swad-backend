PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://127.0.0.1:27017/chai-swad

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Resend order alerts (used after payment verify)
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
ORDER_NOTIFY_EMAIL=

FRONTEND_URL=http://localhost:5173

# No GST on orders.
TAX_PERCENT=0

# Protects PATCH /api/orders/:orderId/status. Leave empty to keep that route disabled.
STAFF_API_KEY=

# Set to true once phone OTP is implemented. History stays unavailable until a verifier is added.
REQUIRE_ORDER_HISTORY_OTP=false

CAFE_NAME=Chai Swad
CAFE_PHONE=
CAFE_WHATSAPP=
CAFE_EMAIL=
CAFE_ADDRESS=
CAFE_INSTAGRAM=
CAFE_GOOGLE_MAPS_URL=
CAFE_OPENING_HOURS=
CAFE_LAT=
CAFE_LNG=
CAFE_DELIVERY_RADIUS_M=500
