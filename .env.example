PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://127.0.0.1:27017/chai-swad

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Meta WhatsApp Cloud API (used when Twilio is not set)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_API_VERSION=v21.0

# Twilio WhatsApp (if TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN are set, Twilio is used instead of Meta)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# order | verification | appointment (default appointment if unset)
TWILIO_WHATSAPP_TEMPLATE=order
# Preferred: ContentSid from Try WhatsApp → Order notification (not the demo appointment HXfe5ab5…)
TWILIO_WHATSAPP_ORDER_CONTENT_SID=
# Fallback only if ORDER_CONTENT_SID is empty (avoid HXfe5ab5 demo appointment SID)
TWILIO_WHATSAPP_CONTENT_SID=

FRONTEND_URL=http://localhost:5173

# No GST on orders.
TAX_PERCENT=0

# Protects PATCH /api/orders/:orderId/status. Leave empty to keep that route disabled.
STAFF_API_KEY=

# Set to true once phone OTP is implemented. History stays unavailable until a verifier is added.
REQUIRE_ORDER_HISTORY_OTP=false

CAFE_NAME=Chai Swad
CAFE_PHONE=
CAFE_WHATSAPP=
CAFE_EMAIL=
CAFE_ADDRESS=
CAFE_INSTAGRAM=
CAFE_GOOGLE_MAPS_URL=
CAFE_OPENING_HOURS=
CAFE_LAT=
CAFE_LNG=
CAFE_DELIVERY_RADIUS_M=500
